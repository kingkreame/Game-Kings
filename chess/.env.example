# Copy to .env for local development. Never commit real secrets.
# Premium purchases stay locked unless this is the string "true".
PASS_GATE_ENABLED=false
# HTTPS page where a player buys one premium game (Gumroad).
CHECKOUT_URL=
# Gumroad product id sent as product_id when verifying a license key.
GUMROAD_PRODUCT_ID=
# Shown on the buy screen, for example $4.99
PRICE_LABEL=
# HMAC secret for the session cookie. Long random string. Render can generate this.
SESSION_SECRET=
PORT=3000
